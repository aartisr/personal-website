ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password
NEXT_PUBLIC_SITE_URL=https://ai-aarti.com
NEXT_PUBLIC_MICROSOFT_CLARITY_ID=your_clarity_project_id
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# Optional: defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com for EU Cloud,
# or your own ingestion endpoint for self-hosted PostHog.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional kill switch. Set to false to disable PostHog without removing the token.
NEXT_PUBLIC_POSTHOG_ENABLED=true
# Optional: GitHub metrics fetch remotely in production and stay off during
# development by default. Set true only when Node trusts your corporate CA.
# GITHUB_METRICS_ENABLED=true
# Preferred production delivery: Resend sends collaboration inquiries directly
# to info@ai-aarti.com. The From address must use a Resend-verified domain.
# RESEND_API_KEY=re_your_api_key
# COLLABORATION_FROM_EMAIL=Aarti Portfolio <collaboration@ai-aarti.com>
# Optional recipient override; defaults to info@ai-aarti.com.
# COLLABORATION_TO_EMAIL=info@ai-aarti.com
# Optional per-attempt timeout in milliseconds (1,000–9,000); defaults to 7,000.
# A timed-out request is retried once with the same idempotency key.
# COLLABORATION_DELIVERY_TIMEOUT_MS=7000
# Optional fallback when Resend is not configured.
# COLLABORATION_WEBHOOK_URL=https://your-owned-inbox-or-workflow.example/webhook
# Required to deliver Support Center contact-form submissions.
# SUPPORT_WEBHOOK_URL=https://your-owned-inbox-or-workflow.example/support-webhook
# Optional but strongly recommended for production: enables shared rate limiting
# across serverless instances (Upstash Redis REST-compatible credentials).
# RATE_LIMIT_REDIS_REST_URL=https://your-redis.upstash.io
# RATE_LIMIT_REDIS_REST_TOKEN=your_redis_rest_token
## Search-console ownership verification and protected IndexNow notifier.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
INDEXNOW_NOTIFY_TOKEN=
