###############################################################################
# Efficient & Generic .gitignore for Monorepo, Node.js, Next.js, and Common Tools
###############################################################################

# Node.js dependencies
node_modules/
apps/*/node_modules/
packages/*/node_modules/

# Build outputs
build/
dist/
apps/*/build/
apps/*/dist/
packages/*/build/
packages/*/dist/

# Next.js
.next/
.next-vercel-preflight/
out/
apps/*/.next/
apps/*/out/
packages/*/.next/
packages/*/out/

# Coverage & test
coverage/
apps/*/coverage/
packages/*/coverage/
playwright-report/
test-results/

# Cache & diagnostics
cache/
dev/
diagnostics/
standalone/
apps/*/cache/
packages/*/cache/

# Logs
logs/
*.log
apps/*/*.log
packages/*/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & config
.env*
!.env.example
apps/*/.env*
packages/*/.env*
local.env*
*.local
.vercel/

# IDE/editor
.vscode/
.idea/
.history/
.DS_Store
apps/*/.DS_Store
packages/*/.DS_Store

# Lock files (except root)
apps/*/package-lock.json
apps/*/bun.lock
apps/*/yarn.lock
packages/*/package-lock.json
packages/*/bun.lock
packages/*/yarn.lock

# TypeScript
*.tsbuildinfo
apps/*/*.tsbuildinfo
packages/*/*.tsbuildinfo

# Miscellaneous
*.pem
next-env.d.ts
content/terms.txt
content/privacy-policy.txt
content/support-center.txt
